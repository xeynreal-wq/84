-- ระบบเวลา
local nightCount = 0
local isNight = false
task.spawn(function()
    while task.wait(1) do
        local totalSeconds = math.floor(workspace.DistributedGameTime)
        local hours = math.floor(totalSeconds / 3600)
        local mins = math.floor((totalSeconds % 3600) / 60)
        local secs = totalSeconds % 60
        
        local clockTime = game:GetService("Lighting").ClockTime
        if (clockTime >= 18 or clockTime < 6) then
            if not isNight then
                isNight = true
                nightCount = nightCount + 1
            end
        else
            isNight = false
        end

        InfoLabel.Text = string.format(
            " [ข้อมูลเซิร์ฟเวอร์]\n • อายุเซิร์ฟ: %d ชม. %d นาที %d วิ\n • ผ่านกลางคืนมาแล้ว: %d คืน\n • สถานะ: %s",
            hours, mins, secs, nightCount, isNight and "กลางคืน 🌙" or "กลางวัน ☀️"
        )
    end
end)

-- สว่างถาวร
local brightActive = false
FixBrightBtn.MouseButton1Click:Connect(function()
    brightActive = not brightActive
    local Lighting = game:GetService("Lighting")
    if brightActive then
        FixBrightBtn.Text = "เปิดสว่างถาวรแล้ว!"
        FixBrightBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
        if _G.BrightLoop then _G.BrightLoop:Disconnect() end
        _G.BrightLoop = game:GetService("RunService").RenderStepped:Connect(function()
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.Brightness = 2
            Lighting.GlobalShadows = false
        end)
    else
        FixBrightBtn.Text = "เปิดสว่างถาวร (แก้บั๊กคืน)"
        FixBrightBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        if _G.BrightLoop then _G.BrightLoop:Disconnect() end
    end
end)

-- ลบหมอก
ClearFogBtn.MouseButton1Click:Connect(function()
    local Lighting = game:GetService("Lighting")
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 9e9
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") then
            v:Destroy()
        end
    end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v:IsA("MeshPart") then
            v.Material = Enum.Material.SmoothPlastic
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v:Destroy()
        end
    end
    ClearFogBtn.Text = "ลบหมอกเรียบร้อย!"
    ClearFogBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
end)

-- ยิงเส้นเลเซอร์
GearTracerBtn.MouseButton1Click:Connect(function()
    local targetGear = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Gear" or v.Name == "MysticGear" or (v:IsA("BasePart") and string.find(v.Name, "Gear")) then
            targetGear = v
            break
        end
    end

    if targetGear then
        local hl = Instance.new("Highlight")
        hl.Parent = targetGear
        hl.FillColor = Color3.fromRGB(0, 255, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)

        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local a0 = Instance.new("Attachment", char.HumanoidRootPart)
            local a1 = Instance.new("Attachment", targetGear)
            local beam = Instance.new("Beam", char.HumanoidRootPart)
            beam.Attachment0 = a0
            beam.Attachment1 = a1
            beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
            beam.Width0 = 0.5
            beam.Width1 = 0.5
            beam.FaceCamera = true
        end

        GearTracerBtn.Text = "เจอเฟือง! ยิงเส้นนำทางแล้ว"
        GearTracerBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
    else
        GearTracerBtn.Text = "ยังไม่พบเฟืองในแมพ"
    end
end)

-- 1. ยิงเสาไฟบีคอนสีฟ้าพุ่งทะลุฟ้า (Beacon Light)
GearBeaconBtn.MouseButton1Click:Connect(function()
    local targetGear = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Gear" or v.Name == "MysticGear" or (v:IsA("BasePart") and string.find(v.Name, "Gear")) then
            targetGear = v
            break
        end
    end

    if targetGear then
        local beacon = Instance.new("Part")
        beacon.Size = Vector3.new(2, 2000, 2)
        beacon.Position = targetGear.Position + Vector3.new(0, 1000, 0)
        beacon.Anchored = true
        beacon.CanCollide = false
        beacon.Material = Enum.Material.Neon
        beacon.Color = Color3.fromRGB(0, 255, 255)
        beacon.Transparency = 0.2
        beacon.Parent = workspace

        GearBeaconBtn.Text = "ยิงเสาไฟฟ้าขึ้นฟ้าแล้ว!"
        GearBeaconBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
    else
        GearBeaconBtn.Text = "ยังไม่พบเฟืองในแมพ"
    end
end)

-- 2. ส่องกล้องตรงไปที่ตัวเฟืองทันที (Cam Spectate)
local spectating = false
CamGearBtn.MouseButton1Click:Connect(function()
    local targetGear = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Gear" or v.Name == "MysticGear" or (v:IsA("BasePart") and string.find(v.Name, "Gear")) then
            targetGear = v
            break
        end
    end

    local cam = workspace.CurrentCamera
    local char = game.Players.LocalPlayer.Character

    if targetGear then
        spectating = not spectating
        if spectating then
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = CFrame.new(targetGear.Position + Vector3.new(0, 5, 8), targetGear.Position)
            CamGearBtn.Text = "กำลังส่องเฟือง (กดซ้ำเพื่อยกเลิก)"
            CamGearBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
        else
            if char and char:FindFirstChild("Humanoid") then
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = char.Humanoid
            end
            CamGearBtn.Text = "ส่องกล้องดูตำแหน่งเฟืองสดๆ"
            CamGearBtn.BackgroundColor3 = Color3.fromRGB(230, 200, 0)
        end
    else
        CamGearBtn.Text = "ยังไม่พบเฟืองในแมพ"
    end
end)

